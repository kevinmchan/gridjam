# Firebase web config (safe to expose for client apps; these are not secrets).
# Create a Realtime Database project at https://console.firebase.google.com,
# then copy these values from Project settings → General → Your apps → SDK setup.
# Save your real values in a gitignored .env.local file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
